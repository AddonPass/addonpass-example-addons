# Same URL for test mode and live mode.
ADDONPASS_API_URL=https://api.addonpass.com
# From the addon's page in the AddonPass dashboard. Starts with ap_test_ or ap_live_.
ADDONPASS_INTEGRATION_CREDENTIAL=
# Leave empty until you create a plan, then list its ID (comma separated) and restart.
ADDONPASS_ALLOWED_PLAN_IDS=
ADDONPASS_MANAGEMENT_URL=https://addonpass.com/subscriptions
PORT=7000
